<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="24dp"
    android:paddingTop="12dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <!-- Section Title: Appointment -->
    <TextView
        android:id="@+id/tvAppointmentTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/appointment"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- See All Link -->
    <TextView
        android:id="@+id/btnSeeAll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/see_all"
        android:textColor="@color/primary_blue"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/tvAppointmentTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvAppointmentTitle" />

    <!-- Appointment Card Container -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cardAppointment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_appointment_card"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvAppointmentTitle">

        <!-- Left Accent Blue Indicator -->
        <View
            android:id="@+id/indicatorBlue"
            android:layout_width="6dp"
            android:layout_height="0dp"
            android:background="@drawable/bg_blue_indicator"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- "Appointment date" Label -->
        <TextView
            android:id="@+id/tvDateLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="16dp"
            android:text="@string/appointment_date_label"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            app:layout_constraintStart_toEndOf="@id/indicatorBlue"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- More Options Button -->
        <ImageView
            android:id="@+id/btnMoreOptions"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="16dp"
            android:contentDescription="@string/cd_more_options"
            android:src="@drawable/ic_more_vert"
            app:layout_constraintBottom_toBottomOf="@id/tvDateLabel"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvDateLabel" />

        <!-- Date & Time Row -->
        <LinearLayout
            android:id="@+id/layoutDateTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toStartOf="@id/btnMoreOptions"
            app:layout_constraintStart_toEndOf="@id/indicatorBlue"
            app:layout_constraintTop_toBottomOf="@id/tvDateLabel">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_clock" />

            <TextView
                android:id="@+id/tvAppointmentTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/appointment_time"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Divider Line -->
        <View
            android:id="@+id/dividerCard"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="20dp"
            android:background="@color/divider_color"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/indicatorBlue"
            app:layout_constraintTop_toBottomOf="@id/layoutDateTime" />

        <!-- Doctor Avatar Layout -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutDoctorAvatar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/indicatorBlue"
            app:layout_constraintTop_toBottomOf="@id/dividerCard">

            <!-- Doctor Circle Photo -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imgDoctorAvatar"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:contentDescription="@string/doctor_name"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_user_placeholder"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearanceOverlay="@style/CircleImage" />

            <!-- Video Call Green Badge -->
            <ImageView
                android:id="@+id/imgVideoBadge"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:background="@drawable/bg_video_badge"
                android:contentDescription="@string/cd_video_badge"
                android:padding="4dp"
                android:src="@drawable/ic_video"
                app:layout_constraintBottom_toBottomOf="@id/imgDoctorAvatar"
                app:layout_constraintEnd_toEndOf="@id/imgDoctorAvatar" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Doctor Name -->
        <TextView
            android:id="@+id/tvDoctorName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:text="@string/doctor_name"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/layoutDoctorAvatar"
            app:layout_constraintTop_toTopOf="@id/layoutDoctorAvatar" />

        <!-- Doctor Specialty -->
        <TextView
            android:id="@+id/tvDoctorSpecialty"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="16dp"
            android:text="@string/doctor_specialty"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/layoutDoctorAvatar"
            app:layout_constraintTop_toBottomOf="@id/tvDoctorName" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>